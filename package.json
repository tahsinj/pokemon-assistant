{
  "name": "stab-lab",
  "version": "0.1.0",
  "description": "Unofficial team and battle lab for Pokémon Showdown singles: dex, team builder, damage calc, counters, usage stats",
  "main": "dist-electron/main/main.js",
  "author": "Tahsin",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.electron.json && electron .",
    "build:renderer": "vite build",
    "build:electron": "node -e \"require('fs').rmSync('dist-electron',{recursive:true,force:true})\" && tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "pack:win": "npm run build && electron-builder --win --x64",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:prose": "node scripts/lint-prose.mjs",
    "lint:css": "node scripts/lint-css.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json && tsc -p tsconfig.tests.json",
    "check": "npm run lint && npm run lint:prose && npm run lint:css && npm run typecheck && npm test",
    "build-dex": "node scripts/build-dex.mjs",
    "fetch-usage": "node scripts/fetch-usage.mjs",
    "test:ui": "playwright test",
    "bots:gauntlet": "node scripts/bots-gauntlet.mjs",
    "simgen": "node scripts/simgen.mjs",
    "test:electron": "node scripts/electron-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/ui": "^4.1.6",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.5",
    "esbuild": "^0.21.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.2",
    "vitest": "^4.1.6",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@pkmn/client": "^0.7.3",
    "@pkmn/data": "^0.10.11",
    "@pkmn/protocol": "^0.7.3",
    "@pkmn/randoms": "^0.10.11",
    "@pkmn/sim": "^0.10.11",
    "@smogon/calc": "^0.12.0",
    "fuse.js": "^7.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.1"
  },
  "build": {
    "appId": "com.tahsin.stablab",
    "productName": "STAB Lab",
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "STABLab-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
